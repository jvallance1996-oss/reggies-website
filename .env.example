# Local development only. Put production secrets in DigitalOcean environment settings.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PUBLIC_DIR=.
# Leave empty locally to accept the exact current localhost origin.
# Production must be the single canonical HTTPS origin, with no trailing slash.
PUBLIC_ORIGIN=

# Development SQLite only. Production never falls back to this file.
QUOTE_DB_PATH=./data/quotes.sqlite
# Production: external managed PostgreSQL connection string.
DATABASE_URL=
# Optional PostgreSQL provider CA PEM. Actual newlines or literal \n are supported.
# Production enforces certificate validation; it never sets rejectUnauthorized=false.
DATABASE_CA_CERT=

# All six settings are required to accept a production quote.
# Use a verified sender and the operator's actual destination inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
QUOTE_TO=

# Optional private read-only inbox at /admin/quotes; username is jack.
# Empty disables the route. Choose and store your own strong password.
ADMIN_PASSWORD=

# Keep 0 unless behind a trusted reverse proxy. Set to the exact proxy-hop count.
# The trusted edge must append/replace X-Forwarded-For correctly.
TRUST_PROXY_HOPS=0
# Optional additional public root frontend JS filenames, comma separated.
# script.js and quote-form.js are already allowed. Never add server source here.
PUBLIC_JS_FILES=
